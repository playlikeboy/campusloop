# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable
# Launch video, poster and captions. Unversioned filenames, so a week plus SWR, not immutable.
# Workers assets answer Range requests natively; the header just advertises it.
/launch/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=2592000
  Accept-Ranges: bytes
# Digital Asset Links for the Chrome Android app (TWA, space.campusloop.twa). Android and Chrome
# fetch this to verify the app, so it must be JSON, unredirected and readable cross-origin.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public,max-age=3600
  Access-Control-Allow-Origin: *
