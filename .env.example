# ─── Database (Neon Postgres) ───
# DB_URL is what the app reads; DATABASE_URL is accepted as a fallback.
DB_URL="postgres://user:password@host/campusloop?sslmode=require"
DATABASE_URL=""

# ─── Hexclave Auth ───
NEXT_PUBLIC_HEXCLAVE_API_URL="https://api.hexclave.com"
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=""
HEXCLAVE_SECRET_SERVER_KEY=""

# GitHub Student Developer Pack verification (/settings/verify). A GitHub OAuth
# app separate from sign-in. Callback URL: https://campusloop.space/api/verify/github/callback
GITHUB_VERIFY_CLIENT_ID=""
GITHUB_VERIFY_CLIENT_SECRET=""

# ─── Anonymous identity vault ───
# ANON_PEPPER: HMAC key for pseudonym handles. Generate: openssl rand -hex 32
# ANON_VAULT_SECRET: AES-256 key sealing real identities. Generate: openssl rand -hex 32
# Both must NEVER rotate casually — handles are derived from the pepper and
# sealed identities become undecryptable if the vault secret is lost.
ANON_PEPPER=""
ANON_VAULT_SECRET=""

# ─── Admin console auth ───
# Admin access is authorized via verified owner emails: sh20raj@gmail.com, btech10574.24@bitmesra.ac.in
# ADMIN_SESSION_SECRET: HMAC key signing the admin session cookie.
# Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=""
ADMIN_PASSKEY=""
ADMIN_API_KEY=""
UPLOAD_API_KEY=""
INDEXNOW_KEY=""

# ─── Web Push (VAPID) ───
# Generate a keypair with: bun run scripts/generate-vapid-keys.ts
# Push stays dormant and the opt-in UI stays hidden until these are set.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is inlined at build time, so it must be present
# in the build environment, not just at runtime.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@campusloop.space"

# ─── Media & integrations ───
IMGBB_API_KEY=""
NEXT_PUBLIC_IMGBB_API_KEY=""
GIPHY_API_KEY=""
NEXT_PUBLIC_GIPHY_API_KEY=""

# ─── Cloudflare Email Sending ───
# Configured via native Cloudflare Worker send_email binding in wrangler.jsonc
# and transactional notifications in src/lib/email.ts
CLOUDFLARE_EMAIL_FROM="notifications@campusloop.space"
CLOUDFLARE_EMAIL_NAME="CampusLoop"
CLOUDFLARE_REPLY_TO="support@campusloop.space"
EMAIL_NOTIFICATIONS_ENABLED="true"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_API_TOKEN_EMAIL_SENDING=""
# Admin -> Emails campaigns (src/lib/email-campaigns). Unsubscribe links are signed with
# EMAIL_UNSUBSCRIBE_SECRET (falls back to CRON_SECRET). "false" pauses all campaign sending.
EMAIL_UNSUBSCRIBE_SECRET=""
EMAIL_CAMPAIGNS_ENABLED="true"
EMAIL_CAMPAIGN_BATCH_SIZE="50"
EMAIL_CAMPAIGN_BATCHES_PER_RUN="4"
# R2 S3-compatible credentials (worker itself uses the MEDIA_BUCKET binding)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_S3_ENDPOINT=""

# ── Merchant portal ──
# HMAC key for merchant portal sessions. REQUIRED: the merchant portal fails
# closed without it. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
MERCHANT_AUTH_SECRET=""

# ── Unsplash API ──
# Free Developer Keys from https://unsplash.com/developers
UNSPLASH_APP_ID=""
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# ── Reddit Campus Ingestion Pipeline ──
# Official Reddit OAuth API credentials (Script App from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_REFRESH_TOKEN=""
REDDIT_USER_AGENT="CampusLoop:v1.0.0 (by /u/campusloop_official)"

# ── Multi-App Orchestration & Playlist Importers ──
# Optional Composio API Key for Google Drive and external integrations (https://app.composio.dev)
COMPOSIO_API_KEY=""

# Bing Webmaster Tools API key (scripts/seo/bing-submit.ts, .github/workflows/bing-submit.yml)
BING_WEBMASTER_API_KEY=
